{
    "name": "sleqq/tibia-reader",
    "description": "Reader for Tibia client .dat and .spr files (versions 7.60-10.84): sprite extraction, object parsing and outfit rendering.",
    "type": "library",
    "keywords": ["tibia", "spr", "dat", "sprites", "outfits"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-gd": "*"
    },
    "autoload": {
        "psr-4": {
            "TibiaReader\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "TibiaReader\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-data": "@php bin/download-test-data.php"
    },
    "config": {
        "process-timeout": 0
    }
}
